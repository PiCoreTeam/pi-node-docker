set -e

export DEBIAN_FRONTEND=noninteractive
apt-get install -y gnupg rsync wget webfs ca-certificates
install -d /usr/share/keyrings
wget -qO - https://apt.stellar.org/SDF.asc | gpg --dearmor -o /usr/share/keyrings/SDF.gpg
echo "deb [signed-by=/usr/share/keyrings/SDF.gpg] https://apt.stellar.org noble stable" >/etc/apt/sources.list.d/SDF.list
echo "deb [signed-by=/usr/share/keyrings/SDF.gpg] https://apt.stellar.org noble unstable" >/etc/apt/sources.list.d/SDF-unstable.list
apt-get update
apt-get install -y stellar-archivist
apt-get clean
echo "\nDone installing stellar-archivist\n"
