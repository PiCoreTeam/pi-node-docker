# Pi Network does not patch stellar-core — use the upstream prebuilt binary.
# Building v26 from source requires clang>=20 / g++>=14 (C++20), which Ubuntu
# focal/jammy in our previous build stage do not provide. The official image
# already ships a release-built binary on noble (matches our runtime base).
ARG STELLAR_CORE_PREBUILT=stellar/stellar-core:26.0.1-3109.e78c97ed0.noble
FROM ${STELLAR_CORE_PREBUILT} AS source

FROM ubuntu:noble
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get -y install libunwind8 postgresql curl sqlite iproute2 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=source /usr/bin/stellar-core /usr/local/bin/stellar-core
EXPOSE 11625
EXPOSE 11626
CMD ["stellar-core"]
