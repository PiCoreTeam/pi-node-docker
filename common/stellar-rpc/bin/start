#! /bin/bash

set -e
set -o pipefail

while ! stellar-core --conf /opt/stellar/core/etc/stellar-core.cfg http-command info &> /dev/null ; do
  echo "Waiting for stellar-core to be available..."
  sleep 1
done

echo "starting stellar-rpc..."
exec /usr/bin/stellar-rpc --config-path /opt/stellar/stellar-rpc/etc/stellar-rpc.cfg
